[Unit]
Description=Passport Admin Service
After=network.target mysql.service

[Service]
User=root
WorkingDirectory=/data/apps/gooyoit-passport-admin/backend
ExecStart=/data/apps/gooyoit-passport-admin/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8081 --access-log --log-level info
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
EnvironmentFile=/data/apps/gooyoit-passport-admin/backend/.env

[Install]
WantedBy=multi-user.target
