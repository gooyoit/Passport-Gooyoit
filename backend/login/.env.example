APP_NAME="Gooyoit Passport"
DEBUG=true
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/passport
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=change-me-in-production-with-at-least-32-bytes
JWT_ISSUER=gooyoit-passport
COOKIE_SECURE=false
FRONTEND_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","https://passport.gooyoit.com"]

# 第三方 OAuth 密钥。AppID 按接入应用保存在 application_login_methods.config，
# AppSecret 只通过 client_secret_env 引用，不写入数据库。
PASSPORT_WECHAT_CLIENT_SECRET=

# 邮箱发送
RESEND_API_KEY=

# WebAuthn / Passkey
# RP_ID: 域名安全边界，必须是当前页面 hostname 的后缀或完全匹配
#   本地开发用 localhost，生产环境改为实际域名（如 passport.gooyoit.com）
WEBAUTHN_RP_ID=localhost
# RP_NAME: 纯展示名，在浏览器 Passkey 弹窗中显示
WEBAUTHN_RP_NAME=Gooyoit Passport
# RP_ORIGIN: 请求来源的完整 origin（含协议），用于校验 clientDataJSON
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# ── 短信验证码（阿里云）─────────────────────────────────
# 未配置（SMS_PROVIDER 留空）时短信登录方式不可用，服务不会启动 SMS 发送
# SMS_PROVIDER="aliyun"
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=          # 短信签名（需在阿里云控制台报备通过）
# ALIYUN_SMS_TEMPLATE_CODE=      # 模板 CODE（模板变量名必须是 code）
# ALIYUN_SMS_ENDPOINT="dysmsapi.aliyuncs.com"
# SMS_CODE_TTL_SECONDS=600
# SMS_RATE_PHONE_PER_MINUTE=1
# SMS_RATE_PHONE_PER_HOUR=5
# SMS_RATE_PHONE_PER_DAY=10
# SMS_RATE_IP_PER_HOUR=10
# SMS_RATE_IP_PER_DAY=30
